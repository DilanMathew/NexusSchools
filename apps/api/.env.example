NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://attendiq:attendiq@localhost:5432/attendiq_dev
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
QR_TOKEN_SECRET=change-me-qr-secret-at-least-32-chars-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
# Optional AI provider (core platform works without it)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
